[Unit]
Description=Spry.ai restricted root workstation executor
Requires=bridge-hostd.socket
After=bridge-hostd.socket network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/lib/bridge/bridge-hostd --policy /etc/bridge/host-policy.json
StateDirectory=bridge-hostd workstation-session
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5s
# One operation is bounded to 1800 seconds. SIGTERM stops admission and drains
# the action through its durable result while retaining the shared flock.
TimeoutStopSec=31min
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# Session safety needs the host's complete /proc and existing DRM namespace.
# Do not copy the API service's PrivateDevices/ProtectProc restrictions here.
PrivateDevices=no
PrivateUsers=no
ProtectProc=default
ProcSubset=all
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/bridge-hostd /var/lib/workstation-session /run/workstation /var/lib/spry-bridge-evidence
MemoryMax=1G
TasksMax=128
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
