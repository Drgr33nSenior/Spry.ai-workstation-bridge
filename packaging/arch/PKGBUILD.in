# Generated by `make arch-source VERSION=vMAJOR.MINOR.PATCH`; do not edit the
# generated copy. This local source package is not an AUR submission. The
# owner has not selected a licence, so this recipe deliberately declares none.
pkgname=spry-ai-workstation-bridge
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Private workstation management controller and command-line client'
url='https://github.com/Drgr33nSenior/Spry.ai-workstation-bridge'
arch=('x86_64')
# Licence decision pending. Do not add a licence declaration until the owner
# selects distribution terms.
depends=('bash' 'coreutils' 'jq' 'systemd' 'util-linux')
makedepends=('go')
optdepends=(
  'kubectl: reviewed host executor Kubernetes adapter'
  'bubblewrap: contained named build recipes'
  'ccache: qualified compiler cache adapter'
)
options=('!strip' '!debug')
source=('@SOURCE_ARCHIVE@')
sha256sums=('@SOURCE_SHA256@')

_source_dir="$pkgname-$pkgver"

prepare() {
  cd "$srcdir/$_source_dir"
  export GOTOOLCHAIN=local
  export CGO_ENABLED=0
  local expected actual
  expected=$(<.go-version)
  actual=$(go env GOVERSION)
  [[ "$actual" == "go$expected" ]] || {
    printf 'Go %s is required; found %s\n' "$expected" "$actual" >&2
    return 1
  }
  go mod download
  go mod verify
}

build() {
  cd "$srcdir/$_source_dir"
  export GOTOOLCHAIN=local
  export CGO_ENABLED=0
  go build -mod=readonly -trimpath -buildvcs=false -ldflags=-buildid= -o bridged ./cmd/bridged
  go build -mod=readonly -trimpath -buildvcs=false -ldflags=-buildid= -o bridgectl ./cmd/bridgectl
  go build -mod=readonly -trimpath -buildvcs=false -ldflags=-buildid= -o bridge-hostd ./cmd/bridge-hostd
  go build -mod=readonly -trimpath -buildvcs=false -ldflags=-buildid= -o bridge-worker ./cmd/bridge-worker
}

check() {
  cd "$srcdir/$_source_dir"
  export GOTOOLCHAIN=local
  export CGO_ENABLED=0
  go test -mod=readonly ./...
}

package() {
  cd "$srcdir/$_source_dir"
  install -Dm755 bridged "$pkgdir/usr/lib/bridge/bridged"
  install -Dm755 bridgectl "$pkgdir/usr/lib/bridge/bridgectl"
  install -Dm755 bridge-hostd "$pkgdir/usr/lib/bridge/bridge-hostd"
  install -Dm755 bridge-worker "$pkgdir/usr/lib/bridge/bridge-worker"
  # Bind the binary package to the reviewed source archive, not its version label.
  install -d "$pkgdir/usr/share/doc/$pkgname"
  printf '%s\n' "${sha256sums[0]}" > "$pkgdir/usr/share/doc/$pkgname/source.sha256"
  install -d "$pkgdir/usr/bin"
  ln -s ../lib/bridge/bridgectl "$pkgdir/usr/bin/bridgectl"

  install -Dm644 deployment/systemd/bridged.service "$pkgdir/usr/lib/systemd/system/bridged.service"
  install -Dm644 deployment/systemd/bridge-hostd.service "$pkgdir/usr/lib/systemd/system/bridge-hostd.service"
  install -Dm644 deployment/systemd/bridge-hostd.socket "$pkgdir/usr/lib/systemd/system/bridge-hostd.socket"
  install -Dm644 deployment/systemd/bridge-worker.service "$pkgdir/usr/lib/systemd/system/bridge-worker.service"
  install -Dm644 deployment/systemd/bridge-worker.socket "$pkgdir/usr/lib/systemd/system/bridge-worker.socket"
  install -Dm644 deployment/systemd/bridge.sysusers "$pkgdir/usr/lib/sysusers.d/bridge.conf"
  install -Dm644 deployment/systemd/bridge.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/bridge.conf"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  local document
  for document in docs/*.md; do
    install -Dm644 "$document" "$pkgdir/usr/share/doc/$pkgname/docs/${document##*/}"
  done
  install -Dm644 api/openapi.json "$pkgdir/usr/share/doc/$pkgname/api/openapi.json"
  install -Dm644 deployment/server.local.example.json "$pkgdir/usr/share/$pkgname/examples/server.local.example.json"
  install -Dm644 deployment/server.vpn.example.json "$pkgdir/usr/share/$pkgname/examples/server.vpn.example.json"
  install -Dm644 deployment/management.initial.example.json "$pkgdir/usr/share/$pkgname/examples/management.initial.example.json"
  install -Dm644 deployment/host-policy.example.json "$pkgdir/usr/share/$pkgname/examples/host-policy.example.json"
  install -Dm644 deployment/worker-policy.example.json "$pkgdir/usr/share/$pkgname/examples/worker-policy.example.json"
  install -Dm644 deployment/session-policy.conf.example "$pkgdir/usr/share/$pkgname/examples/session-policy.conf.example"
  install -Dm644 deployment/kubernetes-rbac.yaml "$pkgdir/usr/share/$pkgname/examples/kubernetes-rbac.yaml"
}
